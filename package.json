{
  "name": "github-stats-svg",
  "version": "1.0.0",
  "description": "Dynamic 2D & 3D GitHub stats SVG cards with animated gradients, generated via GitHub Actions workflow",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist .cache output/*.svg",
    "test": "node --experimental-vm-modules node_modules/.bin/jest"
  },
  "keywords": [
    "github",
    "stats",
    "svg",
    "profile",
    "readme",
    "github-actions",
    "3d",
    "animated",
    "gradient"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^9.5.0",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
